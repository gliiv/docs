{
  "theme": "mint",
  "name": "Gliiv Docs",
  "description": "Guides and API reference for Gliiv bulk SMS. Add senders, upload contacts, send or schedule messages and connect the API.",
  "colors": {
    "primary": "#415a77"
  },
  "logo": "/logo/light.svg",
  "favicon": "/favicon.ico",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "footer": {
    "socials": {
      "website": "https://www.gliiv.com"
    }
  },
  "search": {
    "prompt": "Search the docs..."
  },
  "seo": {
    "metatags": {
      "canonical": "https://www.gliiv.com/docs",
      "viewport": "width=device-width, initial-scale=1.0",
      "description": "Guides and API reference for Gliiv bulk SMS. Add senders, upload contacts, send or schedule messages and connect the API.",
      "keywords": "Gliiv, bulk SMS, SMS API, developer documentation, SMS integration",
      "author": "Gliiv Team",
      "robots": "index, follow",
      "googlebot": "index, follow",
      "theme-color": "#415A77",
      "color-scheme": "light",
      "og:title": "Gliiv Docs: Bulk SMS Guides & API Reference",
      "og:url": "https://www.gliiv.com/docs",
      "og:image": "/images/og-image.png",
      "og:locale": "en_RW",
      "twitter:card": "summary_large_image",
      "twitter:title": "Gliiv Docs: Bulk SMS Guides & API Reference",
      "twitter:image": "/images/og-image.png"
    },
    "indexing": "navigable",
    "organization": {
      "legalName": "Gliiv LTD",
      "url": "https://www.gliiv.com/",
      "sameAs": [
        "https://www.linkedin.com/company/gliivapp",
        "https://x.com/gliivapp",
        "https://www.instagram.com/gliivapp",
        "https://www.youtube.com/@gliivapp"
      ]
    }
  },
  "fonts": {
    "heading": {
      "family": "NunitoSans",
      "source": "https://www.gliiv.com/fonts/nunito-sans-700.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "NunitoSans",
      "source": "https://www.gliiv.com/fonts/nunito-sans-400.woff2",
      "format": "woff2"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "contextual": {
    "options": ["claude", "chatgpt", "cursor", "copy", "vscode"],
    "display": "header"
  },
  "metadata": {
    "timestamp": true
  },
  "variables": {
    "api_url": "https://api.gliiv.com/v1/api"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Campaign Management",
            "pages": [
              "create-campaign"
            ]
          },
          {
            "group": "Updates",
            "pages": [
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "pages": [
          "authentication",
          {
            "group": "Senders",
            "pages": [
              "list-senders",
              "get-sender"
            ]
          },
          {
            "group": "Messages",
            "pages": [
              "send-sms"
            ]
          }
        ]
      }
    ]
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Lost in Transit",
      "description": "This page could not be found. Head back to our [Quickstart](/quickstart) to get your setup running or explore the [API Reference](/authentication) to clear your requests."
    }
  }
}
